rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ROL DE ADMINISTRADOR ASIGNADO DE FORMA EXCLUSIVA E INFALIBLE A eduardomuleth@gmail.com
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email.lower() == 'eduardomuleth@gmail.com';
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /reportes/{reporteId} {
      // 1. Administrador (eduardomuleth@gmail.com): permisos instantáneos de lectura y escritura sin evaluaciones cíclicas
      allow read, write: if isAdmin();

      // 2. Ciudadanos autenticados:
      allow create: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.origen == 'simulacion'
      );
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.uid ||
        resource.data.estado == 'aceptado' ||
        resource.data.estado == 'aprobado'
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.uid &&
        request.resource.data.estado == resource.data.estado
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.uid ||
        resource.data.origen == 'simulacion'
      );
    }

    match /incidentes/{reporteId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated();
    }
  }
}
