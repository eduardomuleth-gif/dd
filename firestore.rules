rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'eduardomuleth@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'eduardomuleth@gmail.com') ||
        request.auth.token.email == 'admin.seguridad@securityurban.medellin.gov.co'
      );
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
    }

    match /reportes/{reporteId} {
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.origen == 'simulacion'
      );

      allow read: if resource.data.estado == 'aceptado' ||
                     resource.data.estado == 'aprobado' ||
                     (isAuthenticated() && (
                       isAdmin() ||
                       request.auth.uid == resource.data.uid
                     ));

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == resource.data.uid && request.resource.data.estado == resource.data.estado)
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == resource.data.uid ||
        resource.data.origen == 'simulacion'
      );
    }

    match /incidentes/{reporteId} {
      allow create: if isAuthenticated();
      allow read: if resource.data.estado == 'aceptado' ||
                     resource.data.estado == 'aprobado' ||
                     isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == resource.data.uid && request.resource.data.estado == resource.data.estado)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == resource.data.uid
      );
    }

    match /alertas_comunales/{alertaId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }
  }
}
