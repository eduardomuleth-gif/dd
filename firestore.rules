rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador');
    }

    match /usuarios/{userId} {
      // Authenticated users can read users list and check suspension state
      allow read: if isAuthenticated();
      
      // A user can create their initial registration document
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Self-update basic fields, or admins can update any field (including rol and estado)
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      
      // Deletions allowed for the account owner (account deletion) or administrators
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
    }

    match /reportes/{reporteId} {
      // 1. Creation: Must be authenticated, author UID must match, initial status must be 'pendiente'
      allow create: if isAuthenticated() && 
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == 'pendiente';

      // 2. Read:
      // - Admins can read all reports
      // - The author can read their own report (even if pendiente or rechazado)
      // - Any authenticated user can read if it has been verified and accepted
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == resource.data.uid ||
        resource.data.estado == 'aceptado'
      );

      // 3. Update:
      // - Admins can update any field (including verifying/accepting/rejecting)
      // - The author can update their own report title/description/content (without changing the status themselves)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == resource.data.uid && request.resource.data.estado == resource.data.estado)
      );

      // 4. Delete: Admins or the author can delete
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == resource.data.uid
      );
    }
  }
}
